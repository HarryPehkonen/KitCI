# Local CI configuration (C++). Copied from AI-DEV-STARTER's templates/cpp/.ci.env.example
# and adapted to KitCI's stage set (SPEC.md §6: format -> build -> lint -> tests -> fuzz).
#
# Copy to .ci.env (gitignored) and edit what you need. This file is documentation: every
# knob below has a default in tools/ci.sh, so with no .ci.env at all the repo behaves
# exactly as described here.
#
#   cp .ci.env.example .ci.env

# Parallel build jobs for the build / clang / fuzz stages.
CI_JOBS=4

# Build type for the normal (gcc) build.
CI_BUILD_TYPE=Debug

# The second compiler the `build` stage runs: SPEC.md §6 asks for gcc AND clang with zero
# warnings, and the whole point of the second one is that the two disagree about warnings.
CI_CLANG_BUILD_DIR=build-clang

# The libFuzzer build directory (clang, -fsanitize=fuzzer,address,undefined).
CI_FUZZ_BUILD_DIR=build-fuzz

# How long the fuzz stage runs the parser. SPEC.md §6: 60 seconds.
CI_FUZZ_SECONDS=60

# Stages run when no stage names are given on the command line.
CI_DEFAULT_STAGES="tree format build lint tests fuzz"

# 1 = a missing tool (clang-format, clang-tidy) FAILS the run instead of SKIPping it.
# Set to 1 on a machine that is supposed to have them, so a silently missing gate
# cannot pass unnoticed.
CI_STRICT_TOOLS=0

# Where per-stage output goes. Gitignored; on failure the tail is printed and the path is
# named. Every one of these paths must be in .gitignore: the tree stage fails when the
# gate's own footprint would show up as an untracked file.
CI_LOG_DIR=.ci-logs

# The source set the format and lint stages own (a space-separated list of git pathspecs).
CI_SOURCE_GLOBS="'*.cpp' '*.cc' '*.cxx' '*.hpp' '*.hh' '*.h'"

# The test runner, given to `eval` with $CI_BUILD_DIR and $CI_JOBS expanded at run time.
CI_TEST_CMD="ctest --test-dir \$CI_BUILD_DIR --output-on-failure -j \$CI_JOBS"
